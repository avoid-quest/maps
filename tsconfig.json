{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleSuffixes": [
      ".native",
      ""
    ],
    "resolveJsonModule": true,
    "types": [
      "node",
      "react",
      "nativewind/types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "dist"
  ]
}
