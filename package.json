{
  "name": "avoid-maps",
  "version": "0.2.0-beta.3",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "index.ts",
  "scripts": {
    "start": "AVOID_MAPS_VARIANT=development expo start --dev-client --lan --scheme avoid-maps-dev",
    "web": "expo start --web",
    "android": "AVOID_MAPS_VARIANT=development expo run:android",
    "typecheck": "bun check",
    "test": "bun test",
    "build:android": "bash scripts/build-android.sh",
    "export:web": "expo export --platform web",
    "ios": "expo run:ios",
    "postinstall": "node scripts/prepare-web-assets.mjs",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "data:smoke": "bun scripts/data-smoke.ts",
    "verify": "bun run typecheck && bun run lint && bun run test",
    "doctor": "CI=1 expo install --check && expo-doctor",
    "prebuild:android:dev": "AVOID_MAPS_VARIANT=development expo prebuild --clean --platform android --no-install"
  },
  "dependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "15.0.3",
    "@gorhom/bottom-sheet": "5.2.14",
    "@maplibre/maplibre-react-native": "11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.7",
    "expo": "54.0.37",
    "expo-asset": "12.0.14",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "15.0.9",
    "expo-dev-client": "6.0.21",
    "expo-file-system": "19.0.24",
    "expo-font": "14.0.12",
    "expo-navigation-bar": "5.0.10",
    "expo-network": "8.0.8",
    "expo-splash-screen": "31.0.13",
    "expo-sqlite": "16.0.10",
    "expo-status-bar": "3.0.9",
    "expo-system-ui": "6.0.9",
    "fflate": "0.8.3",
    "maplibre-gl": "6.13.0",
    "nativewind": "4.2.7",
    "protobufjs": "8.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@maplibre/maplibre-gl-style-spec": "26.2.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "babel-preset-expo": "54.0.12",
    "eslint": "9.39.5",
    "eslint-config-expo": "10.0.0",
    "expo-doctor": "1.20.4",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.3",
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/datetimepicker"
      ]
    },
    "autolinking": {
      "android": {
        "exclude": [
          "expo-dev-client"
        ]
      }
    }
  }
}
